rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function estEditeur() {
      return connecte()
        && exists(/databases/$(database)/documents/editeurs/$(request.auth.uid));
    }
    function estAdmin() {
      return estEditeur()
        && get(/databases/$(database)/documents/editeurs/$(request.auth.uid)).data.role == 'admin';
    }

    // Articles publiés : lisibles par tous, écrits par l'administrateur seul.
    match /articles/{id} {
      allow read: if true;
      allow write: if estAdmin();
      match /photos/{p} {
        allow read: if true;
        allow write: if estAdmin();
      }
    }

    // Articles des élèves en attente de validation.
    match /propositions/{id} {
      allow read: if estAdmin()
        || (estEditeur() && resource.data.auteurId == request.auth.uid);
      allow create: if estEditeur()
        && request.resource.data.auteurId == request.auth.uid;
      allow update: if estAdmin()
        || (estEditeur()
            && resource.data.auteurId == request.auth.uid
            && request.resource.data.auteurId == request.auth.uid);
      allow delete: if estAdmin()
        || (estEditeur() && resource.data.auteurId == request.auth.uid);

      match /photos/{p} {
        allow read: if estAdmin()
          || (estEditeur()
              && get(/databases/$(database)/documents/propositions/$(id)).data.auteurId == request.auth.uid);
        allow create, update: if estAdmin()
          || (estEditeur()
              && getAfter(/databases/$(database)/documents/propositions/$(id)).data.auteurId == request.auth.uid);
        allow delete: if estAdmin()
          || (estEditeur()
              && get(/databases/$(database)/documents/propositions/$(id)).data.auteurId == request.auth.uid);
      }
    }

    // Compteurs de vues, de lectures et de « je n'aime pas » :
    // chaque lecteur ajoute ou retire 1, seule la rédaction voit les chiffres.
    match /stats/{id} {
      allow read: if estEditeur();
      allow create: if request.resource.data.keys().hasOnly(['vues', 'lectures', 'jaimepas'])
        && request.resource.data.get('vues', 1) == 1
        && request.resource.data.get('lectures', 1) == 1
        && request.resource.data.get('jaimepas', 1) == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['vues', 'lectures', 'jaimepas'])
        && request.resource.data.get('vues', 0) - resource.data.get('vues', 0) in [0, 1]
        && request.resource.data.get('lectures', 0) - resource.data.get('lectures', 0) in [0, 1]
        && request.resource.data.get('jaimepas', 0) - resource.data.get('jaimepas', 0) in [-1, 0, 1]
        && request.resource.data.get('jaimepas', 0) >= 0;
    }

    // « J'aime » : visibles par tous.
    // Nombre de téléphones ayant installé l'application.
    match /compteurs/{id} {
      allow read: if estAdmin();
      allow create: if request.resource.data.keys().hasOnly(['installations'])
        && request.resource.data.installations == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['installations'])
        && request.resource.data.installations - resource.data.get('installations', 0) == 1;
    }

    match /reactions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['jaime'])
        && request.resource.data.jaime == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jaime'])
        && request.resource.data.jaime - resource.data.get('jaime', 0) in [-1, 1]
        && request.resource.data.jaime >= 0;
    }

    match /editeurs/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estAdmin());
      allow list: if estAdmin();
      allow create, update: if estAdmin() && request.resource.data.role != 'admin';
      allow delete: if estAdmin();
    }

    // Fils en direct : lisibles par tous. L'administrateur les lance et les termine,
    // les membres de la rédaction publient des mises à jour et changent le score.
    match /directs/{id} {
      allow read: if true;
      allow create, delete: if estAdmin();
      allow update: if estAdmin()
        || (estEditeur() && resource.data.enCours == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB']));
      match /messages/{m} {
        allow read: if true;
        allow create: if estEditeur()
          && request.resource.data.auteurId == request.auth.uid
          && get(/databases/$(database)/documents/directs/$(id)).data.enCours == true;
        allow update: if estAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if estAdmin()
          || (estEditeur() && resource.data.auteurId == request.auth.uid);
      }
    }

    // Présentation de l'équipe de la rédaction.
    // Émissions audio préenregistrées : lisibles par tous, publiées par l'administrateur.
    match /emissions/{id} {
      allow read: if true;
      allow create, delete: if estAdmin();
      allow update: if estAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      match /morceaux/{m} {
        allow read: if true;
        allow write: if estAdmin();
      }
    }

    // Vidéos YouTube présentées dans l'application.
    match /videos/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    match /equipe/{m} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Personnel administratif et pédagogique du lycée.
    match /personnel/{m} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Cours par niveau et matière, écrits par l'administrateur et les professeurs.
    // Le compte des professeurs est partagé : la liste de leurs noms, avec
    // leurs niveaux et matières, est à part, lisible par l'équipe connectée.
    match /profs_liste/{id} {
      allow read: if estEditeur();
      allow write: if estAdmin();
    }
    function fichePersonnelle() {
      return get(/databases/$(database)/documents/editeurs/$(request.auth.uid)).data;
    }
    function peutCours() {
      return estEditeur() && fichePersonnelle().role in ['admin', 'professeur'];
    }
    // Pour un professeur, le nom choisi doit exister dans profs_liste et
    // autoriser ce niveau et cette matière (listes vides = sans restriction).
    function niveauMatiereAutorises(d) {
      return fichePersonnelle().role == 'admin'
        || (d.profId is string && d.profId.size() > 0
            && exists(/databases/$(database)/documents/profs_liste/$(d.profId))
            && get(/databases/$(database)/documents/profs_liste/$(d.profId)).data.nom == d.auteurNom
            && (get(/databases/$(database)/documents/profs_liste/$(d.profId)).data.niveaux.size() == 0
                || d.niveau in get(/databases/$(database)/documents/profs_liste/$(d.profId)).data.niveaux)
            && (get(/databases/$(database)/documents/profs_liste/$(d.profId)).data.matieres.size() == 0
                || d.matiere in get(/databases/$(database)/documents/profs_liste/$(d.profId)).data.matieres));
    }
    match /cours/{id} {
      allow read: if true;
      allow create: if peutCours()
        && request.resource.data.auteurId == request.auth.uid
        && niveauMatiereAutorises(request.resource.data);
      allow update: if estAdmin()
        || (peutCours() && resource.data.auteurId == request.auth.uid && niveauMatiereAutorises(request.resource.data));
      allow delete: if estAdmin()
        || (peutCours() && resource.data.auteurId == request.auth.uid);

      match /pdf/{p} {
        allow read: if true;
        allow write: if estAdmin()
          || (peutCours() && get(/databases/$(database)/documents/cours/$(id)).data.auteurId == request.auth.uid);
      }
    }

    // Le message de bienvenue est public ; le reste de la configuration est réservé.
    match /config/{doc} {
      allow read: if doc in ['accueil', 'contact'] || estAdmin();
      allow write: if estAdmin();
    }
  }
}
