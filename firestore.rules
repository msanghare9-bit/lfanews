rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function estEditeur() {
      return connecte()
        && exists(/databases/$(database)/documents/editeurs/$(request.auth.uid));
    }
    function estAdmin() {
      return estEditeur()
        && get(/databases/$(database)/documents/editeurs/$(request.auth.uid)).data.role == 'admin';
    }

    // Articles publiés : lisibles par tous, écrits par l'administrateur seul.
    match /articles/{id} {
      allow read: if true;
      allow write: if estAdmin();
      match /photos/{p} {
        allow read: if true;
        allow write: if estAdmin();
      }
    }

    // Articles des élèves en attente de validation.
    match /propositions/{id} {
      allow read: if estAdmin()
        || (estEditeur() && resource.data.auteurId == request.auth.uid);
      allow create: if estEditeur()
        && request.resource.data.auteurId == request.auth.uid;
      allow update: if estAdmin()
        || (estEditeur()
            && resource.data.auteurId == request.auth.uid
            && request.resource.data.auteurId == request.auth.uid);
      allow delete: if estAdmin()
        || (estEditeur() && resource.data.auteurId == request.auth.uid);

      match /photos/{p} {
        allow read: if estAdmin()
          || (estEditeur()
              && get(/databases/$(database)/documents/propositions/$(id)).data.auteurId == request.auth.uid);
        allow create, update: if estAdmin()
          || (estEditeur()
              && getAfter(/databases/$(database)/documents/propositions/$(id)).data.auteurId == request.auth.uid);
        allow delete: if estAdmin()
          || (estEditeur()
              && get(/databases/$(database)/documents/propositions/$(id)).data.auteurId == request.auth.uid);
      }
    }

    // Compteurs de vues, de lectures et de « je n'aime pas » :
    // chaque lecteur ajoute ou retire 1, seule la rédaction voit les chiffres.
    match /stats/{id} {
      allow read: if estEditeur();
      allow create: if request.resource.data.keys().hasOnly(['vues', 'lectures', 'jaimepas'])
        && request.resource.data.get('vues', 1) == 1
        && request.resource.data.get('lectures', 1) == 1
        && request.resource.data.get('jaimepas', 1) == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['vues', 'lectures', 'jaimepas'])
        && request.resource.data.get('vues', 0) - resource.data.get('vues', 0) in [0, 1]
        && request.resource.data.get('lectures', 0) - resource.data.get('lectures', 0) in [0, 1]
        && request.resource.data.get('jaimepas', 0) - resource.data.get('jaimepas', 0) in [-1, 0, 1]
        && request.resource.data.get('jaimepas', 0) >= 0;
    }

    // « J'aime » : visibles par tous.
    match /reactions/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['jaime'])
        && request.resource.data.jaime == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jaime'])
        && request.resource.data.jaime - resource.data.get('jaime', 0) in [-1, 1]
        && request.resource.data.jaime >= 0;
    }

    match /editeurs/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estAdmin());
      allow write: if false;
    }

    match /config/{doc} {
      allow read, write: if estAdmin();
    }
  }
}
